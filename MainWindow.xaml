<Window
    x:Class="HNClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="HN.EXE">

    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D1117"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="CardBrush" Color="#21262D"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#00FF88"/>
        <SolidColorBrush x:Key="HighlightBrush" Color="#58A6FF"/>

        <SolidColorBrush x:Key="PrimaryText" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#8B949E"/>

    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->

        <Border Grid.Row="0"
                Background="{StaticResource SidebarBrush}">

            <Grid Padding="12,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text=">"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="Cascadia Code"
                               FontSize="16" />

                    <TextBlock Text=" HN.EXE"
                               Foreground="{StaticResource PrimaryText}"
                               FontFamily="Cascadia Code"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="CTRL+P"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}"
                           FontFamily="Cascadia Code"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- NAVIGATION -->
                <ColumnDefinition Width="220"/>

                <!-- STORIES -->
                <ColumnDefinition Width="380"/>

                <!-- SPLITTER -->
                <ColumnDefinition Width="5"/>

                <!-- DETAILS -->
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION -->

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- USER -->

                    <StackPanel Margin="20">

                        <Border Width="50"
                                Height="50"
                                CornerRadius="25"
                                Background="{StaticResource AccentBrush}">

                            <TextBlock Text="HN"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                        </Border>

                        <TextBlock Text="guest"
                                   Margin="0,10,0,0"
                                   FontFamily="Cascadia Code"
                                   Foreground="{StaticResource PrimaryText}"/>

                    </StackPanel>

                    <!-- CHANNELS -->

                    <StackPanel Grid.Row="1"
                                Margin="12">

                        <TextBlock Text="SECTIONS"
                                   Margin="8"
                                   Foreground="{StaticResource SecondaryText}"
                                   FontFamily="Cascadia Code"/>

                        <NavigationView
                            PaneDisplayMode="Left"
                            IsPaneOpen="True"
                            IsBackButtonVisible="Collapsed">

                            <NavigationView.MenuItems>

                                <NavigationViewItem
                                    Content="Top"
                                    Icon="Favorite"/>

                                <NavigationViewItem
                                    Content="Best"
                                    Icon="Like"/>

                                <NavigationViewItem
                                    Content="New"
                                    Icon="View"/>

                                <NavigationViewItem
                                    Content="Ask HN"
                                    Icon="Help"/>

                                <NavigationViewItem
                                    Content="Show HN"
                                    Icon="Document"/>

                                <NavigationViewItem
                                    Content="Jobs"
                                    Icon="Work"/>

                                <NavigationViewItem
                                    Content="Bookmarks"
                                    Icon="OutlineStar"/>

                            </NavigationView.MenuItems>

                        </NavigationView>

                    </StackPanel>

                    <!-- STATUS -->

                    <Border Grid.Row="2"
                            Margin="12"
                            Padding="12"
                            CornerRadius="10"
                            Background="{StaticResource CardBrush}">

                        <StackPanel>

                            <TextBlock Text="STATUS"
                                       Foreground="{StaticResource SecondaryText}"
                                       FontSize="11"/>

                            <TextBlock Text="API Connected"
                                       Foreground="{StaticResource AccentBrush}"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>

            <!-- STORY LIST -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SEARCH -->

                <AutoSuggestBox
                    Grid.Row="0"
                    Margin="12"
                    PlaceholderText="Search Hacker News..."
                    QueryIcon="Find"/>

                <!-- STORIES -->

                <ListView Grid.Row="1"
                          Margin="12"
                          ItemsSource="{Binding Stories}">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="0,0,0,8"
                                    Padding="12"
                                    Background="{StaticResource CardBrush}"
                                    CornerRadius="12">

                                <StackPanel>

                                    <TextBlock
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryText}"/>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Margin="0,8,0,0">

                                        <TextBlock
                                            Text="{Binding Score}"
                                            Foreground="{StaticResource AccentBrush}"/>

                                        <TextBlock
                                            Text=" pts • "
                                            Foreground="{StaticResource SecondaryText}"/>

                                        <TextBlock
                                            Text="{Binding By}"
                                            Foreground="{StaticResource HighlightBrush}"/>

                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

            <!-- SPLITTER -->

            <GridSplitter Grid.Column="2"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#2D333B"/>

            <!-- RIGHT PANEL -->

            <Grid Grid.Column="3">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="260"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOOLBAR -->

                <CommandBar Grid.Row="0"
                            DefaultLabelPosition="Right">

                    <AppBarButton
                        Label="Open"
                        Icon="World"/>

                    <AppBarButton
                        Label="Bookmark"
                        Icon="Favorite"/>

                    <AppBarButton
                        Label="Refresh"
                        Icon="Refresh"/>

                    <AppBarSeparator/>

                    <AppBarButton
                        Label="Share"
                        Icon="Share"/>

                </CommandBar>

                <!-- ARTICLE -->

                <Border Grid.Row="1"
                        Margin="12"
                        Background="{StaticResource CardBrush}"
                        CornerRadius="12">

                    <ScrollViewer>

                        <StackPanel Margin="16">

                            <TextBlock
                                Text="{Binding SelectedStory.Title}"
                                FontSize="26"
                                FontWeight="Bold"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource PrimaryText}"/>

                            <TextBlock
                                Margin="0,10,0,16"
                                Text="{Binding SelectedStory.By}"
                                Foreground="{StaticResource HighlightBrush}"/>

                            <TextBlock
                                Text="{Binding SelectedStory.Text}"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource PrimaryText}"/>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

                <!-- COMMENTS -->

                <Border Grid.Row="2"
                        Margin="12"
                        Background="{StaticResource CardBrush}"
                        CornerRadius="12">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock
                            Margin="16"
                            Text="COMMENTS"
                            FontFamily="Cascadia Code"
                            Foreground="{StaticResource AccentBrush}"
                            FontSize="16"/>

                        <TreeView Grid.Row="1"
                                  Margin="12"
                                  ItemsSource="{Binding Comments}">

                            <TreeView.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel Margin="0,8">

                                        <TextBlock
                                            Text="{Binding By}"
                                            Foreground="{StaticResource HighlightBrush}"
                                            FontWeight="Bold"/>

                                        <TextBlock
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource PrimaryText}"/>

                                    </StackPanel>

                                </DataTemplate>

                            </TreeView.ItemTemplate>

                        </TreeView>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>
